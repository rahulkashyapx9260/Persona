<!--
  Adaptive-icon foreground: two white figures, a larger one in front and a
  smaller one half a step behind. Drawn as paths rather than a bitmap so the
  mark stays sharp at every launcher size.

  The artwork sits inside the 66x66 safe zone of the 108x108 canvas, so no
  part of it is clipped by a round, squircle or squared mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Smaller figure, behind and to the right. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M59.5,43 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M60,65.5 A9.5,9.5 0 0 1 69.5,56 A9.5,9.5 0 0 1 79,65.5 L79,74 A8,8 0 0 1 71,82 L68,82 A8,8 0 0 1 60,74 Z" />

    <!-- Larger figure, in front. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M30.5,37.5 a12.5,12.5 0 1,0 25,0 a12.5,12.5 0 1,0 -25,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M29,65 A13,13 0 0 1 42,52 L44,52 A13,13 0 0 1 57,65 L57,74 A9,9 0 0 1 48,83 L38,83 A9,9 0 0 1 29,74 Z" />
</vector>
